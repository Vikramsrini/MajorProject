# --- large, reproducible artifacts: not tracked ---------------------------------
# The benchmark itself (download with scripts/download_wdc.py).
data/
*.zip
*.json.gz

# Per-pair score dumps (45 MB). Regenerate with scripts/run_wdc.py; every claim in the
# paper can be recomputed from the summary CSVs, which ARE tracked.
# per-pair score dumps and their .json sidecars
results/*_scored_*

logs/

# --- python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# embedding caches live outside the repo, but guard local accidents
*.npy
*.faiss

# --- macOS / editors ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- deliberately TRACKED, despite being generated ------------------------------
# paper/tables/*.tex and figures/* must be in the repo, otherwise a fresh clone
# cannot compile the paper or verify that a table matches a result file. They are
# small (~1.8 MB) and are regenerated by:
#   python scripts/make_tables.py && python scripts/make_figures.py
